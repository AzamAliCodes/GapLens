# ==============================================================================
# GAPLENS ENVIRONMENT VARIABLES
# ==============================================================================

# LLM Provider selection (optional: 'google' | 'openai' | 'anthropic')
# If omitted, auto-selects based on which API key is present.
# If no key is provided, the platform automatically switches to high-fidelity Offline Demo Mode.
LLM_PROVIDER=google

# Google Gemini API Key (Recommended)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Search API Key for Source Suggestion (Optional: Tavily or Brave)
# SEARCH_API_KEY=your_search_api_key_here

# Force Offline Demo Mode without network requests (Optional: 'true' | 'false')
NEXT_PUBLIC_DEMO_ONLY=false
